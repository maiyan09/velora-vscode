{
  "name": "velora-studio",
  "displayName": "Velora",
  "description": "A minimal VS Code experience with elegant themes and productivity tools",
  "version": "0.0.1",
  "icon": "media/velora-logo.png",
  "publisher": "maiyan09",
  "vscode:prepublish": "npm run compile",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  
  
  
  "contributes": {
    "commands": [
      {
        "command": "velora.welcome",
        "title": "Welcome to Velora",
        "category": "Velora"
      },
      {
        "command": "velora.selectFont",
        "title": "Select Font Preset",
        "category": "Velora"
      },
      {
        "command": "velora.restoreFont",
        "title": "Restore Previous Font",
        "category": "Velora"
      },
      {
        "command": "velora.darkTheme",
        "title": "Activate Dark Theme",
        "category": "Velora"
      },
      {
        "command": "velora.lightTheme",
        "title": "Activate Light Theme",
        "category": "Velora"
      },
      {
        "command": "velora.selectTheme",
        "title": "Select Theme",
        "category": "Velora"
      },
      {
        "command": "velora.openControlCenter",
        "title": "Velora: Open Control Center",
        "category": "Velora"
      },
      {
        "command": "velora.openWelcome",
        "title": "Velora: Open Welcome Screen",
        "category": "Velora"
      },
      {
        "command": "velora.resetOnboarding",
        "title": "Velora: Reset Onboarding",
        "category": "Velora"
      },
      {
        "command": "velora.toggleFocusMode",
        "title": "Velora: Toggle Focus Mode",
        "category": "Velora"
      }
    ],
    "themes": [
      {
        "id": "velora-dark",
        "label": "Velora Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/velora-dark-color-theme.json"
      },
      {
        "id": "velora-light",
        "label": "Velora Light",
        "uiTheme": "vs",
        "path": "./themes/velora-light-color-theme.json"
      }
    ],
    "iconThemes": [
        {
          "id": "velora-file-icons",
          "label": "Velora File Icons",
          "path": "./icons/velora-icon-theme.json"
        }
      ]
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
